SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=your-openrouter-model
X_APP_KEY=your-x-app-key
X_APP_SECRET=your-x-app-secret
X_ACCESS_TOKEN=your-x-access-token
X_ACCESS_SECRET=your-x-access-secret
X_WEBHOOK_SECRET=your-x-webhook-secret
X_WEBHOOK_ID=your-x-webhook-id
WORKER_POLL_INTERVAL_MS=1000
MAX_CONTEXT_MESSAGES=20
MAX_REPLY_CHARS=500
ENABLE_X_REPLAY_BACKFILL=false
X_REPLAY_INTERVAL_MS=300000
X_REPLAY_WINDOW_MINUTES=120
ENABLE_DM_RECONCILIATION=true
DM_RECONCILIATION_INTERVAL_MS=600000
DM_RECONCILIATION_LOOKBACK_MINUTES=180
DM_RECONCILIATION_PAGE_SIZE=50
DELIVERY_LAG_ALERT_MINUTES=20
